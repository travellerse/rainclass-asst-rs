import { Theme } from "theme.slint";
import { LessonRow, EventRow } from "models.slint";
import { NavItem } from "components/nav-item.slint";
import { GlassCard } from "components/glass-card.slint";
import { OverviewPage } from "pages/overview-page.slint";
import { EventsPage } from "pages/events-page.slint";
import { SettingsPage } from "pages/settings-page.slint";

export component AppWindow inherits Window {
    title: "RainClassroom Assistant";
    width: 960px;
    height: 640px;
    background: Theme.bg;

    in-out property <int> current-page: 0;
    in-out property <string> auth-status-text: "未登录";
    in-out property <string> auth-status-kind: "offline";
    in-out property <string> monitor-status-text: "监控未启动";
    in-out property <bool> monitor-running: false;
    in-out property <int> selected-lesson-index: -1;
    in-out property <string> last-error-text: "";
    in-out property <string> app-version-text: "v0.1.0";

    in-out property <[LessonRow]> lessons: [];
    in-out property <[EventRow]> events: [];

    in-out property <int> setting-monitor-interval: 5;
    in-out property <bool> setting-auto-checkin: true;
    in-out property <bool> setting-auto-answer: true;
    in-out property <bool> setting-auto-answer-random-guess: false;
    in-out property <int> setting-answer-delay: 500;
    in-out property <bool> setting-notify-enabled: true;
    in-out property <string> setting-webhook-url: "";
    in-out property <bool> setting-check-update-on-startup: true;
    in-out property <string> setting-active-tenant: "Hetang";

    callback login-clicked();
    callback logout-clicked();
    callback start-monitor-clicked();
    callback stop-monitor-clicked();
    callback check-update-clicked();
    callback save-config-clicked();

    HorizontalLayout {
        Rectangle {
            width: Theme.sidebar-width;
            background: Theme.sidebar-bg;

            VerticalLayout {
                padding: Theme.spacing-md;
                spacing: Theme.spacing-xs;

                VerticalLayout {
                    spacing: Theme.spacing-xs;
                    padding-bottom: Theme.spacing-lg;

                    Text {
                        text: "🎓";
                        font-size: Theme.font-xxl;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "摸鱼课堂";
                        font-size: Theme.font-lg;
                        font-weight: 700;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.app-version-text;
                        font-size: Theme.font-xs;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border-light;
                }

                NavItem {
                    icon: "📊";
                    label: "总览";
                    active: root.current-page == 0;
                    activated => {
                        root.current-page = 0;
                    }
                }

                NavItem {
                    icon: "📋";
                    label: "事件日志";
                    active: root.current-page == 1;
                    activated => {
                        root.current-page = 1;
                    }
                }

                NavItem {
                    icon: "⚙️";
                    label: "设置";
                    active: root.current-page == 2;
                    activated => {
                        root.current-page = 2;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                GlassCard {
                    height: 48px;

                    HorizontalLayout {
                        padding: Theme.spacing-sm;
                        spacing: Theme.spacing-sm;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: root.auth-status-kind == "online" ? Theme.success : root.auth-status-kind == "waiting" ? Theme.warning : root.auth-status-kind == "error" ? Theme.error : Theme.text-muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.auth-status-text;
                                font-size: Theme.font-xs;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            background: Theme.bg;
            horizontal-stretch: 1;

            if root.current-page == 0: OverviewPage {
                auth-status-text: root.auth-status-text;
                auth-status-kind: root.auth-status-kind;
                monitor-status-text: root.monitor-status-text;
                monitor-running: root.monitor-running;
                last-error-text: root.last-error-text;
                lessons: root.lessons;
                selected-lesson-index <=> root.selected-lesson-index;

                login-clicked => {
                    root.login-clicked();
                }
                logout-clicked => {
                    root.logout-clicked();
                }
                start-monitor-clicked => {
                    root.start-monitor-clicked();
                }
                stop-monitor-clicked => {
                    root.stop-monitor-clicked();
                }
                check-update-clicked => {
                    root.check-update-clicked();
                }
            }

            if root.current-page == 1: EventsPage {
                events: root.events;
            }

            if root.current-page == 2: SettingsPage {
                setting-monitor-interval <=> root.setting-monitor-interval;
                setting-auto-checkin <=> root.setting-auto-checkin;
                setting-auto-answer <=> root.setting-auto-answer;
                setting-auto-answer-random-guess <=> root.setting-auto-answer-random-guess;
                setting-answer-delay <=> root.setting-answer-delay;
                setting-notify-enabled <=> root.setting-notify-enabled;
                setting-webhook-url <=> root.setting-webhook-url;
                setting-check-update-on-startup <=> root.setting-check-update-on-startup;
                setting-active-tenant <=> root.setting-active-tenant;

                save-config-clicked => {
                    root.save-config-clicked();
                }
            }
        }
    }
}
