import { Button, VerticalBox, HorizontalBox, LineEdit, CheckBox, ScrollView, Slider, SpinBox, ComboBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

// ── Data Models ──

export struct LessonRow {
    course-name: string,
    teacher-name: string,
    status: string,
}

export struct EventRow {
    timestamp: string,
    kind: string,      // "info" | "warning" | "error" | "success"
    message: string,
}

// ── Main Window ──

export component AppWindow inherits Window {
    title: "RainClassroom Assistant";
    width: 960px;
    height: 640px;
    background: Theme.bg;

    // ── Properties ──
    in-out property <int> current-page: 0;  // 0=overview, 1=events, 2=settings
    in-out property <string> auth-status-text: "未登录";
    in-out property <string> auth-status-kind: "offline";  // offline, waiting, online, error
    in-out property <string> monitor-status-text: "监控未启动";
    in-out property <bool> monitor-running: false;
    in-out property <string> api-mode-text: "Real API";
    in-out property <string> last-error-text: "";
    in-out property <string> app-version-text: "v0.1.0";

    // Lessons
    in-out property <[LessonRow]> lessons: [];

    // Events log
    in-out property <[EventRow]> events: [];

    // Settings
    in-out property <int> setting-monitor-interval: 5;
    in-out property <bool> setting-auto-checkin: true;
    in-out property <bool> setting-auto-answer: true;
    in-out property <int> setting-answer-delay: 500;
    in-out property <bool> setting-notify-enabled: true;
    in-out property <bool> setting-check-update-on-startup: true;

    // ── Callbacks ──
    callback login-clicked();
    callback logout-clicked();
    callback start-monitor-clicked();
    callback stop-monitor-clicked();
    callback check-update-clicked();
    callback save-config-clicked();

    HorizontalLayout {
        // ══════════ Sidebar ══════════
        Rectangle {
            width: Theme.sidebar-width;
            background: Theme.sidebar-bg;

            VerticalLayout {
                padding: Theme.spacing-md;
                spacing: Theme.spacing-xs;

                // Logo / Brand
                VerticalLayout {
                    spacing: Theme.spacing-xs;
                    padding-bottom: Theme.spacing-lg;

                    Text {
                        text: "🎓";
                        font-size: Theme.font-xxl;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "摸鱼课堂";
                        font-size: Theme.font-lg;
                        font-weight: 700;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.app-version-text;
                        font-size: Theme.font-xs;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }
                }

                // Separator
                Rectangle {
                    height: 1px;
                    background: Theme.border-light;
                }

                // Nav items
                nav-overview := Rectangle {
                    height: 40px;
                    border-radius: Theme.radius-sm;
                    background: root.current-page == 0 ? Theme.sidebar-item-active : transparent;

                    TouchArea {
                        clicked => { root.current-page = 0; }

                        HorizontalLayout {
                            padding-left: Theme.spacing-md;
                            alignment: start;
                            spacing: Theme.spacing-sm;

                            Text {
                                text: "📊";
                                font-size: Theme.font-md;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "总览";
                                font-size: Theme.font-md;
                                color: root.current-page == 0 ? Theme.primary : Theme.text-secondary;
                                vertical-alignment: center;
                                font-weight: root.current-page == 0 ? 600 : 400;
                            }
                        }
                    }
                }

                nav-events := Rectangle {
                    height: 40px;
                    border-radius: Theme.radius-sm;
                    background: root.current-page == 1 ? Theme.sidebar-item-active : transparent;

                    TouchArea {
                        clicked => { root.current-page = 1; }

                        HorizontalLayout {
                            padding-left: Theme.spacing-md;
                            alignment: start;
                            spacing: Theme.spacing-sm;

                            Text {
                                text: "📋";
                                font-size: Theme.font-md;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "事件日志";
                                font-size: Theme.font-md;
                                color: root.current-page == 1 ? Theme.primary : Theme.text-secondary;
                                vertical-alignment: center;
                                font-weight: root.current-page == 1 ? 600 : 400;
                            }
                        }
                    }
                }

                nav-settings := Rectangle {
                    height: 40px;
                    border-radius: Theme.radius-sm;
                    background: root.current-page == 2 ? Theme.sidebar-item-active : transparent;

                    TouchArea {
                        clicked => { root.current-page = 2; }

                        HorizontalLayout {
                            padding-left: Theme.spacing-md;
                            alignment: start;
                            spacing: Theme.spacing-sm;

                            Text {
                                text: "⚙️";
                                font-size: Theme.font-md;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "设置";
                                font-size: Theme.font-md;
                                color: root.current-page == 2 ? Theme.primary : Theme.text-secondary;
                                vertical-alignment: center;
                                font-weight: root.current-page == 2 ? 600 : 400;
                            }
                        }
                    }
                }

                // Spacer
                Rectangle { vertical-stretch: 1; }

                // Bottom auth hint
                Rectangle {
                    height: 48px;
                    border-radius: Theme.radius-sm;
                    background: Theme.bg-surface;

                    HorizontalLayout {
                        padding: Theme.spacing-sm;
                        spacing: Theme.spacing-sm;

                        // Auth status dot
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: root.auth-status-kind == "online" ? Theme.success :
                                            root.auth-status-kind == "waiting" ? Theme.warning :
                                            root.auth-status-kind == "error" ? Theme.error :
                                            Theme.text-muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.auth-status-text;
                                font-size: Theme.font-xs;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }

        // ══════════ Main Content ══════════
        Rectangle {
            background: Theme.bg;
            horizontal-stretch: 1;

            // ──── Page 0: Overview ────
            if root.current-page == 0 : ScrollView {
                VerticalLayout {
                    padding: Theme.spacing-lg;
                    spacing: Theme.spacing-lg;

                    // Header
                    Text {
                        text: "总览";
                        font-size: Theme.font-xl;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }

                    // Status cards row
                    HorizontalLayout {
                        spacing: Theme.spacing-md;

                        // Auth card
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 100px;
                            border-radius: Theme.radius-md;
                            background: Theme.bg-surface;

                            VerticalLayout {
                                padding: Theme.spacing-md;
                                spacing: Theme.spacing-sm;
                                alignment: start;

                                Text {
                                    text: "登录状态";
                                    font-size: Theme.font-xs;
                                    color: Theme.text-muted;
                                    letter-spacing: 0.5px;
                                }
                                Text {
                                    text: root.auth-status-text;
                                    font-size: Theme.font-lg;
                                    font-weight: 600;
                                    color: root.auth-status-kind == "online" ? Theme.success :
                                           root.auth-status-kind == "error" ? Theme.error :
                                           Theme.text-primary;
                                }
                            }
                        }

                        // Monitor card
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 100px;
                            border-radius: Theme.radius-md;
                            background: Theme.bg-surface;

                            VerticalLayout {
                                padding: Theme.spacing-md;
                                spacing: Theme.spacing-sm;
                                alignment: start;

                                Text {
                                    text: "监控状态";
                                    font-size: Theme.font-xs;
                                    color: Theme.text-muted;
                                    letter-spacing: 0.5px;
                                }
                                Text {
                                    text: root.monitor-status-text;
                                    font-size: Theme.font-lg;
                                    font-weight: 600;
                                    color: root.monitor-running ? Theme.success : Theme.text-secondary;
                                }
                            }
                        }

                        // API mode card
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 100px;
                            border-radius: Theme.radius-md;
                            background: Theme.bg-surface;

                            VerticalLayout {
                                padding: Theme.spacing-md;
                                spacing: Theme.spacing-sm;
                                alignment: start;

                                Text {
                                    text: "接口模式";
                                    font-size: Theme.font-xs;
                                    color: Theme.text-muted;
                                    letter-spacing: 0.5px;
                                }
                                Text {
                                    text: root.api-mode-text;
                                    font-size: Theme.font-md;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                            }
                        }
                    }

                    // Actions
                    Rectangle {
                        border-radius: Theme.radius-md;
                        background: Theme.bg-surface;
                        height: self.preferred-height;

                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-md;

                            Text {
                                text: "快捷操作";
                                font-size: Theme.font-sm;
                                color: Theme.text-muted;
                                letter-spacing: 0.5px;
                            }

                            HorizontalLayout {
                                spacing: Theme.spacing-sm;

                                Button {
                                    text: "扫码登录";
                                    primary: true;
                                    clicked => { root.login-clicked(); }
                                }

                                Button {
                                    text: root.monitor-running ? "停止监控" : "启动监控";
                                    clicked => {
                                        if root.monitor-running {
                                            root.stop-monitor-clicked();
                                        } else {
                                            root.start-monitor-clicked();
                                        }
                                    }
                                }

                                Button {
                                    text: "检查更新";
                                    clicked => { root.check-update-clicked(); }
                                }

                                Button {
                                    text: "登出";
                                    clicked => { root.logout-clicked(); }
                                }
                            }
                        }
                    }

                    // Error banner (if any)
                    if root.last-error-text != "" : Rectangle {
                        border-radius: Theme.radius-md;
                        background: Theme.error-light;
                        height: self.preferred-height;

                        HorizontalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-sm;

                            Text {
                                text: "⚠";
                                font-size: Theme.font-md;
                                color: Theme.error;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.last-error-text;
                                font-size: Theme.font-sm;
                                color: Theme.error;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Lesson list
                    Rectangle {
                        border-radius: Theme.radius-md;
                        background: Theme.bg-surface;
                        vertical-stretch: 1;
                        min-height: 200px;

                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-sm;

                            Text {
                                text: "当前课程";
                                font-size: Theme.font-sm;
                                color: Theme.text-muted;
                                letter-spacing: 0.5px;
                            }

                            // Table header
                            Rectangle {
                                height: 36px;
                                border-radius: Theme.radius-sm;
                                background: Theme.bg-card;

                                HorizontalLayout {
                                    padding-left: Theme.spacing-md;
                                    padding-right: Theme.spacing-md;

                                    Text {
                                        text: "课程名";
                                        font-size: Theme.font-sm;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                        horizontal-stretch: 2;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "教师";
                                        font-size: Theme.font-sm;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "状态";
                                        font-size: Theme.font-sm;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Table body
                            if root.lessons.length == 0 : Rectangle {
                                height: 60px;
                                Text {
                                    text: "暂无课程";
                                    font-size: Theme.font-sm;
                                    color: Theme.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            for lesson[idx] in root.lessons : Rectangle {
                                height: 42px;
                                border-radius: Theme.radius-sm;
                                background: Math.mod(idx, 2) == 0 ? transparent : Theme.bg-card;

                                HorizontalLayout {
                                    padding-left: Theme.spacing-md;
                                    padding-right: Theme.spacing-md;

                                    Text {
                                        text: lesson.course-name;
                                        font-size: Theme.font-sm;
                                        color: Theme.text-primary;
                                        horizontal-stretch: 2;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: lesson.teacher-name;
                                        font-size: Theme.font-sm;
                                        color: Theme.text-secondary;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: lesson.status;
                                        font-size: Theme.font-sm;
                                        color: lesson.status == "上课中" ? Theme.success : Theme.text-muted;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ──── Page 1: Event Log ────
            if root.current-page == 1 : VerticalLayout {
                padding: Theme.spacing-lg;
                spacing: Theme.spacing-md;

                Text {
                    text: "事件日志";
                    font-size: Theme.font-xl;
                    font-weight: 700;
                    color: Theme.text-primary;
                }

                Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.bg-surface;
                    vertical-stretch: 1;

                    if root.events.length == 0 : Text {
                        text: "暂无事件";
                        font-size: Theme.font-sm;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    ScrollView {
                        VerticalLayout {
                            padding: Theme.spacing-sm;
                            spacing: 2px;

                            for event[idx] in root.events : Rectangle {
                                height: 38px;
                                border-radius: Theme.radius-sm;
                                background: Math.mod(idx, 2) == 0 ? transparent : Theme.bg-card;

                                HorizontalLayout {
                                    padding-left: Theme.spacing-md;
                                    padding-right: Theme.spacing-md;
                                    spacing: Theme.spacing-md;

                                    // Kind indicator dot
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: event.kind == "error" ? Theme.error :
                                                        event.kind == "warning" ? Theme.warning :
                                                        event.kind == "success" ? Theme.success :
                                                        Theme.primary;
                                        }
                                    }

                                    // Timestamp
                                    Text {
                                        text: event.timestamp;
                                        font-size: Theme.font-xs;
                                        color: Theme.text-muted;
                                        vertical-alignment: center;
                                        min-width: 60px;
                                    }

                                    // Message
                                    Text {
                                        text: event.message;
                                        font-size: Theme.font-sm;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ──── Page 2: Settings ────
            if root.current-page == 2 : ScrollView {
                VerticalLayout {
                    padding: Theme.spacing-lg;
                    spacing: Theme.spacing-lg;

                    Text {
                        text: "设置";
                        font-size: Theme.font-xl;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }

                    // Monitor settings card
                    Rectangle {
                        border-radius: Theme.radius-md;
                        background: Theme.bg-surface;
                        height: self.preferred-height;

                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-md;

                            Text {
                                text: "监控设置";
                                font-size: Theme.font-md;
                                font-weight: 600;
                                color: Theme.text-primary;
                            }

                            // Monitor interval
                            HorizontalLayout {
                                spacing: Theme.spacing-md;
                                alignment: start;

                                Text {
                                    text: "轮询间隔 (秒)";
                                    font-size: Theme.font-sm;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                    min-width: 140px;
                                }
                                SpinBox {
                                    value <=> root.setting-monitor-interval;
                                    minimum: 1;
                                    maximum: 60;
                                }
                            }
                        }
                    }

                    // Automation settings card
                    Rectangle {
                        border-radius: Theme.radius-md;
                        background: Theme.bg-surface;
                        height: self.preferred-height;

                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-md;

                            Text {
                                text: "自动化";
                                font-size: Theme.font-md;
                                font-weight: 600;
                                color: Theme.text-primary;
                            }

                            HorizontalLayout {
                                spacing: Theme.spacing-md;
                                alignment: start;

                                Text {
                                    text: "自动签到";
                                    font-size: Theme.font-sm;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                    min-width: 140px;
                                }
                                CheckBox {
                                    checked <=> root.setting-auto-checkin;
                                    text: root.setting-auto-checkin ? "已启用" : "已停用";
                                }
                            }

                            HorizontalLayout {
                                spacing: Theme.spacing-md;
                                alignment: start;

                                Text {
                                    text: "自动答题";
                                    font-size: Theme.font-sm;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                    min-width: 140px;
                                }
                                CheckBox {
                                    checked <=> root.setting-auto-answer;
                                    text: root.setting-auto-answer ? "已启用" : "已停用";
                                }
                            }

                            HorizontalLayout {
                                spacing: Theme.spacing-md;
                                alignment: start;

                                Text {
                                    text: "答题延迟 (ms)";
                                    font-size: Theme.font-sm;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                    min-width: 140px;
                                }
                                SpinBox {
                                    value <=> root.setting-answer-delay;
                                    minimum: 0;
                                    maximum: 5000;
                                }
                            }
                        }
                    }

                    // Notifications card
                    Rectangle {
                        border-radius: Theme.radius-md;
                        background: Theme.bg-surface;
                        height: self.preferred-height;

                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-md;

                            Text {
                                text: "通知与更新";
                                font-size: Theme.font-md;
                                font-weight: 600;
                                color: Theme.text-primary;
                            }

                            HorizontalLayout {
                                spacing: Theme.spacing-md;
                                alignment: start;

                                Text {
                                    text: "系统通知";
                                    font-size: Theme.font-sm;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                    min-width: 140px;
                                }
                                CheckBox {
                                    checked <=> root.setting-notify-enabled;
                                    text: root.setting-notify-enabled ? "已启用" : "已停用";
                                }
                            }

                            HorizontalLayout {
                                spacing: Theme.spacing-md;
                                alignment: start;

                                Text {
                                    text: "启动时检查更新";
                                    font-size: Theme.font-sm;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                    min-width: 140px;
                                }
                                CheckBox {
                                    checked <=> root.setting-check-update-on-startup;
                                    text: root.setting-check-update-on-startup ? "已启用" : "已停用";
                                }
                            }
                        }
                    }

                    // Save button
                    HorizontalLayout {
                        alignment: end;

                        Button {
                            text: "保存配置";
                            primary: true;
                            clicked => { root.save-config-clicked(); }
                        }
                    }
                }
            }
        }
    }
}
