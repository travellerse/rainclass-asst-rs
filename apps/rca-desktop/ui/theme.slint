// Design tokens for RainClassroom Assistant Desktop

export global Theme {
    // ── Brand Colors ──
    out property <color> primary: #3b82f6;
    out property <color> primary-hover: #2563eb;
    out property <color> primary-light: #dbeafe;

    // ── Semantic Colors ──
    out property <color> success: #22c55e;
    out property <color> success-light: #dcfce7;
    out property <color> warning: #f59e0b;
    out property <color> warning-light: #fef3c7;
    out property <color> error: #ef4444;
    out property <color> error-light: #fee2e2;

    // ── Neutrals ──
    out property <color> bg: #0f172a;
    out property <color> bg-surface: #1e293b;
    out property <color> bg-card: #334155;
    out property <color> bg-hover: #475569;
    out property <color> border: #475569;
    out property <color> border-light: #334155;

    // ── Text ──
    out property <color> text-primary: #f1f5f9;
    out property <color> text-secondary: #94a3b8;
    out property <color> text-muted: #64748b;
    out property <color> text-on-primary: #ffffff;

    // ── Sizing ──
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 14px;

    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 16px;
    out property <length> spacing-lg: 24px;
    out property <length> spacing-xl: 32px;

    // ── Typography ──
    out property <length> font-xs: 11px;
    out property <length> font-sm: 13px;
    out property <length> font-md: 15px;
    out property <length> font-lg: 18px;
    out property <length> font-xl: 22px;
    out property <length> font-xxl: 28px;

    // ── Sidebar ──
    out property <length> sidebar-width: 200px;
    out property <color> sidebar-bg: #0f172a;
    out property <color> sidebar-item-hover: #1e293b;
    out property <color> sidebar-item-active: #1e293b;
}
