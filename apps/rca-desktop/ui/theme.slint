// Modern Aesthetic Design tokens for RainClassroom Assistant Desktop

export global Theme {
    // ── Brand Colors & Gradients ──
    out property <color> primary: #8b5cf6;       // Purple primary
    out property <color> primary-hover: #7c3aed;
    out property <color> primary-light: #ede9fe;
    out property <color> accent: #3b82f6;        // Blue secondary for contrast

    // ── Semantic Colors ──
    out property <color> success: #10b981;
    out property <color> success-light: #d1fae5;
    out property <color> warning: #f59e0b;
    out property <color> warning-light: #fef3c7;
    out property <color> error: #ef4444;
    out property <color> error-light: #fee2e2;

    // ── Neutrals (Glassmorphism & Depth) ──
    out property <color> bg: #09090b;            // Very dark, almost black
    out property <color> bg-surface: rgba(24, 24, 27, 0.8);     // Slightly transparent card
    out property <color> bg-card: rgba(39, 39, 42, 0.6);        // Inner card
    out property <color> bg-hover: rgba(63, 63, 70, 0.8);
    out property <color> border: rgba(255, 255, 255, 0.1);
    out property <color> border-light: rgba(255, 255, 255, 0.05);

    // ── Text ──
    out property <color> text-primary: #fafafa;
    out property <color> text-secondary: #a1a1aa;
    out property <color> text-muted: #71717a;
    out property <color> text-on-primary: #ffffff;

    // ── Sizing & Geometry ──
    out property <length> radius-sm: 8px;
    out property <length> radius-md: 12px;
    out property <length> radius-lg: 16px;
    out property <length> radius-xl: 24px;

    out property <length> spacing-xs: 6px;
    out property <length> spacing-sm: 10px;
    out property <length> spacing-md: 18px;
    out property <length> spacing-lg: 28px;
    out property <length> spacing-xl: 40px;

    // ── Typography (Sleek proportions) ──
    out property <length> font-xs: 12px;
    out property <length> font-sm: 14px;
    out property <length> font-md: 16px;
    out property <length> font-lg: 20px;
    out property <length> font-xl: 26px;
    out property <length> font-xxl: 32px;

    // ── Sidebar ──
    out property <length> sidebar-width: 220px;
    out property <color> sidebar-bg: rgba(9, 9, 11, 0.95);
    out property <color> sidebar-item-hover: rgba(255, 255, 255, 0.05);
    out property <color> sidebar-item-active: rgba(255, 255, 255, 0.1);
}
