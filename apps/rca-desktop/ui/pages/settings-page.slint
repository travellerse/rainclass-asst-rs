import { SpinBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { GlassCard } from "../components/glass-card.slint";
import { ToggleSwitch } from "../components/toggle-switch.slint";
import { PrimaryButton } from "../components/primary-button.slint";
import { I18n } from "../i18n.slint";

export component SettingsPage inherits Rectangle {
    in-out property <int> setting-monitor-interval;
    in-out property <bool> setting-auto-checkin;
    in-out property <bool> setting-auto-answer;
    in-out property <bool> setting-auto-answer-random-guess;
    in-out property <int> setting-answer-delay;
    in-out property <bool> setting-notify-enabled;
    in-out property <string> setting-webhook-url;
    in-out property <bool> setting-check-update-on-startup;
    in-out property <string> setting-active-tenant;

    callback save-config-clicked();

    background: Theme.bg;

    ScrollView {
        VerticalLayout {
            padding: Theme.spacing-lg;
            spacing: Theme.spacing-lg;

            Text {
                text: I18n.t("nav_settings");
                font-size: Theme.font-xl;
                font-weight: 700;
                color: Theme.text-primary;
            }

            GlassCard {
                height: self.preferred-height;

                VerticalLayout {
                    padding: Theme.spacing-md;
                    spacing: Theme.spacing-md;

                    Text {
                        text: I18n.t("settings_monitor_title");
                        font-size: Theme.font-md;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }

                    HorizontalLayout {
                        spacing: Theme.spacing-md;
                        alignment: start;

                        Text {
                            text: I18n.t("settings_poll_interval");
                            font-size: Theme.font-sm;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            min-width: 160px;
                        }

                        SpinBox {
                            value <=> root.setting-monitor-interval;
                            minimum: 1;
                            maximum: 60;
                            width: 160px;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.spacing-md;
                        alignment: start;

                        Text {
                            text: I18n.t("settings_platform");
                            font-size: Theme.font-sm;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            min-width: 160px;
                        }

                        ComboBox {
                            model: ["Rain", "Hetang", "Yangtze", "YellowRiver"];
                            current-value <=> root.setting-active-tenant;
                            width: 160px;
                        }
                    }
                }
            }

            GlassCard {
                height: self.preferred-height;

                VerticalLayout {
                    padding: Theme.spacing-md;
                    spacing: Theme.spacing-md;

                    Text {
                        text: I18n.t("settings_auto_title");
                        font-size: Theme.font-md;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }

                    HorizontalLayout {
                        spacing: Theme.spacing-md;
                        alignment: start;

                        Text {
                            text: I18n.t("settings_auto_checkin");
                            font-size: Theme.font-sm;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            min-width: 160px;
                        }

                        ToggleSwitch {
                            checked <=> root.setting-auto-checkin;
                        }

                        Text {
                            text: root.setting-auto-checkin ? I18n.t("status_enabled") : I18n.t("status_disabled");
                            font-size: Theme.font-sm;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.spacing-md;
                        alignment: start;

                        Text {
                            text: I18n.t("settings_auto_answer");
                            font-size: Theme.font-sm;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            min-width: 160px;
                        }

                        ToggleSwitch {
                            checked <=> root.setting-auto-answer;
                        }

                        Text {
                            text: root.setting-auto-answer ? I18n.t("status_enabled") : I18n.t("status_disabled");
                            font-size: Theme.font-sm;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.spacing-md;
                        alignment: start;

                        Text {
                            text: I18n.t("settings_random_guess");
                            font-size: Theme.font-sm;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            min-width: 160px;
                        }

                        ToggleSwitch {
                            checked <=> root.setting-auto-answer-random-guess;
                        }

                        Text {
                            text: root.setting-auto-answer-random-guess ? I18n.t("status_enabled") : I18n.t("status_disabled_no_submit");
                            font-size: Theme.font-sm;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.spacing-md;
                        alignment: start;

                        Text {
                            text: I18n.t("settings_answer_delay");
                            font-size: Theme.font-sm;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            min-width: 160px;
                        }

                        SpinBox {
                            value <=> root.setting-answer-delay;
                            minimum: 0;
                            maximum: 5000;
                        }
                    }
                }
            }

            GlassCard {
                height: self.preferred-height;

                VerticalLayout {
                    padding: Theme.spacing-md;
                    spacing: Theme.spacing-md;

                    Text {
                        text: I18n.t("settings_notify_title");
                        font-size: Theme.font-md;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }

                    HorizontalLayout {
                        spacing: Theme.spacing-md;
                        alignment: start;

                        Text {
                            text: I18n.t("settings_system_notify");
                            font-size: Theme.font-sm;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            min-width: 160px;
                        }

                        ToggleSwitch {
                            checked <=> root.setting-notify-enabled;
                        }

                        Text {
                            text: root.setting-notify-enabled ? I18n.t("status_enabled") : I18n.t("status_disabled");
                            font-size: Theme.font-sm;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.spacing-md;
                        alignment: start;

                        Text {
                            text: I18n.t("settings_webhook_url");
                            font-size: Theme.font-sm;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            min-width: 160px;
                        }

                        LineEdit {
                            text <=> root.setting-webhook-url;
                            placeholder-text: I18n.t("settings_webhook_placeholder");
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.spacing-md;
                        alignment: start;

                        Text {
                            text: I18n.t("settings_check_update_startup");
                            font-size: Theme.font-sm;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            min-width: 160px;
                        }

                        ToggleSwitch {
                            checked <=> root.setting-check-update-on-startup;
                        }

                        Text {
                            text: root.setting-check-update-on-startup ? I18n.t("status_enabled") : I18n.t("status_disabled");
                            font-size: Theme.font-sm;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;

                PrimaryButton {
                    text: I18n.t("btn_save_config");
                    clicked => {
                        root.save-config-clicked();
                    }
                }
            }
        }
    }
}
