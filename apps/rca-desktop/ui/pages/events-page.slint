import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { GlassCard } from "../components/glass-card.slint";
import { EventRow } from "../models.slint";
import { I18n } from "../i18n.slint";

export component EventsPage inherits Rectangle {
    in property <[EventRow]> events;

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.spacing-lg;
        spacing: Theme.spacing-md;

        Text {
            text: I18n.t("nav_events");
            font-size: Theme.font-xl;
            font-weight: 700;
            color: Theme.text-primary;
        }

        GlassCard {
            vertical-stretch: 1;

            if root.events.length == 0: Text {
                text: I18n.t("no_events");
                font-size: Theme.font-sm;
                color: Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            ScrollView {
                VerticalLayout {
                    padding: Theme.spacing-sm;
                    spacing: 2px;

                    for event[idx] in root.events: Rectangle {
                        height: 38px;
                        border-radius: Theme.radius-sm;
                        background: Math.mod(idx, 2) == 0 ? transparent : Theme.bg-card;

                        HorizontalLayout {
                            padding-left: Theme.spacing-md;
                            padding-right: Theme.spacing-md;
                            spacing: Theme.spacing-md;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: event.kind == "error" ? Theme.error : event.kind == "warning" ? Theme.warning : event.kind == "success" ? Theme.success : Theme.primary;
                                }
                            }

                            Text {
                                text: event.timestamp;
                                font-size: Theme.font-xs;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                                min-width: 60px;
                            }

                            Text {
                                text: event.message;
                                font-size: Theme.font-sm;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}
